#!/usr/bin/env bash
# create-secrets.sh.example
#
# Creates the rag-secrets Kubernetes Secret required by deployment.yaml.
# Copy this file, fill in real values, and run it once per cluster/namespace.
# NEVER commit the filled-in version to git.
#
# Usage:
#   cp deploy/k8s/create-secrets.sh.example deploy/k8s/create-secrets.sh
#   # edit create-secrets.sh with real values
#   chmod +x deploy/k8s/create-secrets.sh && ./deploy/k8s/create-secrets.sh

NAMESPACE="production"

kubectl create secret generic rag-secrets \
  --namespace="${NAMESPACE}" \
  --from-literal=SECRET_KEY="$(openssl rand -hex 32)" \
  --from-literal=OPENAI_API_KEY="sk-..." \
  --from-literal=GEMINI_API_KEY="AI..." \
  --from-literal=MINIO_ACCESS_KEY="change-me" \
  --from-literal=MINIO_SECRET_KEY="change-me" \
  --from-literal=POSTGRES_PASSWORD="change-me" \
  --from-literal=RABBITMQ_USER="rag" \
  --from-literal=RABBITMQ_PASSWORD="change-me" \
  --dry-run=client -o yaml | kubectl apply -f -

echo "Secret 'rag-secrets' applied to namespace '${NAMESPACE}'."
echo ""
echo "To rotate: re-run this script with updated values, then restart deployments:"
echo "  kubectl rollout restart deployment/rag-api deployment/rag-worker -n ${NAMESPACE}"
