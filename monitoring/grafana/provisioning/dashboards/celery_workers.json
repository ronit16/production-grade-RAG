{
  "title": "Celery Workers",
  "uid": "celery-workers",
  "tags": ["celery", "workers"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Online Workers",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "flower_workers_online",
          "legendFormat": "Workers"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            {"color": "red", "value": 0},
            {"color": "green", "value": 1}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Task Success Rate",
      "type": "timeseries",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 6},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(flower_events_total{type='task-succeeded'}[5m]))",
          "legendFormat": "succeeded/s"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(flower_events_total{type='task-failed'}[5m]))",
          "legendFormat": "failed/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ingestion Task Duration (p95)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(flower_task_runtime_seconds_bucket{name='ingest.process_document'}[10m])) by (le))",
          "legendFormat": "p95 ingest duration"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Tasks Processed",
      "type": "stat",
      "gridPos": {"x": 0, "y": 14, "w": 8, "h": 6},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(flower_events_total{type='task-succeeded'}[1h]))",
          "legendFormat": "Succeeded (1h)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Failed Tasks",
      "type": "stat",
      "gridPos": {"x": 8, "y": 14, "w": 8, "h": 6},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(flower_events_total{type='task-failed'}[1h]))",
          "legendFormat": "Failed (1h)"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 10}
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Retried Tasks",
      "type": "stat",
      "gridPos": {"x": 16, "y": 14, "w": 8, "h": 6},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(flower_events_total{type='task-retried'}[1h]))",
          "legendFormat": "Retried (1h)"
        }
      ]
    }
  ]
}
