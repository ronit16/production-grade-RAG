# Copy this file to .env and fill in the values before running docker compose up.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
SECRET_KEY=                  # min 32 chars; generate with: openssl rand -hex 32

# ── LLM API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# ── Database (set automatically by docker-compose; override for external PG) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/rag_db

# ── Redis (set automatically by docker-compose) ───────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery (set automatically by docker-compose) ──────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant (set automatically by docker-compose) ──────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=              # leave empty for self-hosted; required for Qdrant Cloud

# ── MinIO / Object Storage (set automatically by docker-compose) ──────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001
